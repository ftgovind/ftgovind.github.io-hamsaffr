* { 
    margin: 0; 
    padding: 0; 
    box-sizing: border-box; 
    font-family: Arial, sans-serif; 
}

body { 
    background-color: #1a1a1a; /* Dark background */
    color: #e0e0e0;
    display: flex; 
    justify-content: center; 
    height: 100vh; 
}

.app-container { 
    width: 100%; 
    max-width: 500px; 
    display: flex; 
    flex-direction: column; 
    background-color: #1a1a1a; 
    height: 100%; 
    overflow: hidden;
}

/* 3D Effect Class (Neumorphism) */
.3d-effect {
    border-radius: 12px;
    background: #1a1a1a;
    box-shadow:  5px 5px 10px #111111, -5px -5px 10px #232323;
}

/* Header & Search */
.top-nav {
    padding: 15px;
    margin: 10px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.search-bar input {
    background: #1a1a1a;
    border: none;
    padding: 8px 15px;
    border-radius: 20px;
    color: white;
    box-shadow: inset 3px 3px 6px #111111, inset -3px -3px 6px #232323; /* Inner 3D depth */
    outline: none;
}

/* Stories */
.stories-container {
    display: flex;
    gap: 15px;
    padding: 15px;
    overflow-x: auto;
}

.story {
    min-width: 70px;
    height: 90px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 10px;
    font-size: 0.7rem;
}

.story img {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    margin-bottom: 5px;
    border: 2px solid #ff5722;
}

/* Tabs */
.tabs {
    display: flex;
    justify-content: space-around;
    padding: 10px;
}

.tab-btn {
    padding: 10px 30px;
    border: none;
    color: #888;
    cursor: pointer;
    font-weight: bold;
    transition: 0.3s;
}

.tab-btn.active {
    color: #ff5722;
    box-shadow: inset 3px 3px 6px #111111, inset -3px -3px 6px #232323;
}

/* Content Sections */
.content-section {
    display: none;
    flex: 1;
    overflow-y: auto;
    padding: 10px;
}

.content-section.active {
    display: flex;
    flex-direction: column;
}

/* Feed Post */
.post {
    padding: 15px;
    margin-bottom: 20px;
}

.post-header { margin-bottom: 10px; color: #ff5722; }
.post-image { 
    height: 200px; 
    background-color: #222; 
    border-radius: 8px; 
    margin-bottom: 10px;
    box-shadow: inset 3px 3px 6px #111, inset -3px -3px 6px #232;
}
.post-actions span { margin-right: 15px; font-weight: bold; cursor: pointer;}

/* Chat Area */
#chat-section { flex-direction: column; height: 100%; }
.chat-box { flex: 1; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 15px; }

.message {
    padding: 12px 18px;
    max-width: 75%;
    font-size: 0.9rem;
}

.message.received { align-self: flex-start; border-bottom-left-radius: 0; color: #aaa;}
.message.sent { align-self: flex-end; border-bottom-right-radius: 0; color: #fff;}

.chat-input-area {
    display: flex;
    gap: 10px;
    padding: 15px;
    margin: 10px;
}

#message-input {
    flex: 1;
    background: #1a1a1a;
    border: none;
    padding: 10px 15px;
    border-radius: 20px;
    color: white;
    box-shadow: inset 3px 3px 6px #111, inset -3px -3px 6px #232;
    outline: none;
}

#send-btn {
    border: none;
    padding: 10px 20px;
    color: #ff5722;
    font-weight: bold;
    cursor: pointer;
}
.message img { max-width: 100%; border-radius: 8px; margin-top: 5px; }
